# Server Configuration
PORT=4000
NODE_ENV=production

# PostgreSQL Database (Supports Neon, Supabase, Render, Railway, or local)
# Example: postgresql://postgres:password@db.example.com:5432/proxifix?sslmode=require
DATABASE_URL=postgresql://user:password@hostname:5432/proxifix

# Set to true if your database requires SSL (e.g. Neon, Supabase)
DATABASE_SSL=true

# Security
JWT_ACCESS_SECRET=your_super_secret_jwt_key_generate_something_long_and_random
JWT_ACCESS_EXPIRES_IN=7d

# Frontend CORS Origin (comma-separated if multiple, e.g. https://your-site.vercel.app,http://localhost:5173)
CORS_ORIGIN=https://your-frontend.vercel.app

# Optional Rate Limiter setting
API_RATE_LIMIT_MAX=1200
